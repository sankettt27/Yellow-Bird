# ─── Application Configuration ─────────────────────────────
APP_NAME="Smart School Transport"
APP_VERSION="1.0.0"
DEBUG=true

# ─── Database Configuration ──────────────────────────────
# SQLite (Development Default)
DATABASE_URL=sqlite+aiosqlite:///./transport.db

# PostgreSQL (Production / Docker)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/school_transport

# ─── Security & JWT ──────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── CORS Origins ────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Mapbox Access Token ─────────────────────────────────
# Get token from https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# ─── GPS & Tracking Parameters ───────────────────────────
GPS_UPDATE_INTERVAL_SECONDS=3
OVERSPEED_LIMIT_KMH=60.0
